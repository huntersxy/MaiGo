# Bootstrap secrets and infrastructure only.
# WebUI 登录令牌存在 <MAIBOT_INSTANCE_DIR>/data/webui.json 的 access_token。
# 未自定义时每次启动重新生成，并在启动日志打印「🔑 WebUI 登录 Token」。

# AES-256-GCM master key for model and MCP secrets stored in SQLite.
# Generate with: openssl rand -base64 32
MAIBOT_SECRET_KEY=

# Python Runner 默认拉起（镜像内置解释器与 runner 模块）。
# 仅需纯宿主内置组件时设为 0。
# MAIBOT_PLUGIN_SPAWN=0

# 平台接入统一走适配器：在 WebUI「适配器设置」安装并启用插件适配器，
# 适配器通过 maim_message 与本体通信，无需配置 OneBot 连接变量。

# 数据库默认是 SQLite，落在 <MAIBOT_INSTANCE_DIR>/data/MaiBot.db，
# 对齐 MaiBot src/common/database/database.py:33，无需配置以下变量。
# 也可显式指向其它 SQLite 文件：
# MAIBOT_DATABASE_DSN=/app/data/MaiBot.db

# Optional deployment overrides.
MAIBOT_WEB_PORT=7468
MAIBOT_SERVER_PORT=7468
MAIBOT_MEDIA_DIR=./media
MAIBOT_STICKER_DIR=./stickers
MAIBOT_LOG_LEVEL=info
MAIBOT_DEBUG=false

# 监听地址；容器内保持 0.0.0.0 才能通过端口映射访问（compose 已内置该值）
# HTTP_HOST=0.0.0.0

# Docker 镜像已内置 Dashboard 并设置该变量；源码部署可选，指向含 index.html 的构建目录
# MAIBOT_DASHBOARD_DIR=/path/to/dashboard/dist

# 可选：机械黑话 upsert 后用 learner/utils 模型推断含义（需 model_config 路由可用）
# MAIBOT_JARGON_LLM=1

# 可选：A_Memorix 后端选择（只有进程内原生内核一种后端）。
# MAIBOT_MEMORIX_BACKEND=auto|native   # auto：按 [a_memorix.plugin].enabled 决定；native：强制启用

# 首页资讯（JSON API 或 RSS；默认官方源）
# MAIBOT_NEWS_SOURCE_URL=http://127.0.0.1:10059/news
# MAIBOT_NEWS_URL=  # MAIBOT_NEWS_SOURCE_URL 别名
# MAIBOT_NEWS_REQUEST_TIMEOUT=8
# MAIBOT_NEWS_ITEM_LIMIT=20
# MAIBOT_NEWS_CACHE_TTL=120

# HTML→PNG 渲染：可选的外部 Playwright 渲染服务。
# MAIBOT_HTMLRENDER_URL=http://127.0.0.1:8766/render
# MAIBOT_HTMLRENDER_TIMEOUT=30
# MAIBOT_HTMLRENDER_TOKEN=

# Python 原版能力侧车：中文错别字（pypinyin + jieba）与表达向量聚类（numpy）。
# docker compose 会启动 python-compat 服务，容器内地址为 http://python-compat:8767。
# MAIBOT_COMPAT_URL=http://127.0.0.1:8767
# MAIBOT_COMPAT_TIMEOUT=60
# MAIBOT_COMPAT_TOKEN=              # 同时设置给 Go 与 Python 侧车

# 可选：联网搜索/抓取（默认 Bing 搜索 + HTTP 抓取；设 API Key 后通过 adapter 选供应商）
# MAIBOT_WEB_SEARCH_ADAPTER=tavily|exa|firecrawl|anysearch|stepsearch|bing
# MAIBOT_WEB_FETCH_ADAPTER=tavily|exa|firecrawl|anysearch|stepsearch|http
# StepSearch（复用 WebUI 已启用的 MCP 服务器，工具名对齐 StepSearch MCP 协议）
# MAIBOT_STEPSEARCH_MCP_SERVER=stepsearch
# MAIBOT_STEPSEARCH_MCP_TOOL=web_search
# MAIBOT_STEPSEARCH_MCP_FETCH_TOOL=web_fetch
# MAIBOT_STEPSEARCH_CATEGORY=
# MAIBOT_TAVILY_API_KEY=
# MAIBOT_TAVILY_BASE_URL=https://api.tavily.com
# MAIBOT_EXA_API_KEY=
# MAIBOT_EXA_BASE_URL=https://api.exa.ai
# MAIBOT_FIRECRAWL_API_KEY=
# MAIBOT_FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# MAIBOT_ANYSEARCH_API_KEY=
# MAIBOT_ANYSEARCH_BASE_URL=https://api.anysearch.com
# MAIBOT_WEB_SEARCH_TIMEOUT_SECONDS=60

# Database and model/MCP application settings live in the admin UI.
