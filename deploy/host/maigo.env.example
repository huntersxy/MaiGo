# maigo.service 环境变量；实际文件为 /opt/maigo/maigo.env，权限 600
# 实例根目录：config/data/host/bots/logs/plugins/media/stickers 都在其下
MAIBOT_INSTANCE_DIR=/opt/maigo/app
MAIBOT_HOST_PORT=7468
# 对外监听全部网卡，由云安全组/iptables 限制来源
HTTP_HOST=0.0.0.0
TZ=Asia/Shanghai

# 发布产物随 current 切换
MAIBOT_DASHBOARD_DIR=/opt/maigo/current/dashboard/dist

# 宿主 venv 与版本无关，切换发布不重建
MAIBOT_PLUGIN_PYTHON=/opt/maigo/runtime/plugin-runtime/bin/python
MAIBOT_PLUGIN_PROJECT_ROOT=/opt/maigo/runtime/plugin-runtime/lib/python3.12/site-packages

MAIBOT_PLUGIN_DEP_INDEX_URLS=https://pypi.tuna.tsinghua.edu.cn/simple
MAIBOT_LEGACY_0X_UPGRADE_CONFIRMED=1

# 内存剖析端点：只监听回环，按需抓取
MAIBOT_PPROF_ADDR=127.0.0.1:6060
GOMEMLIMIT=384MiB
GOGC=80

# 首次部署沿用 data/.secret_key 里的密钥；为空时不会覆盖已有数据
MAIBOT_SECRET_KEY=
