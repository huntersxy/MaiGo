# Python 兼容侧车（错别字注入 + 表达向量聚类）。
#
# 只装这两个能力真正需要的依赖：不继承 MaiBot 运行镜像（那个带 faiss / playwright，
# 约 2GB），也不装 MaiBot 自身。MaiBot 的原版源码由 compose 以只读方式挂载到
# /MaiMBot/src，侧车按文件路径加载 typo_generator.py 与 expression_vector_index.py。
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Asia/Shanghai

RUN pip install --no-cache-dir \
        "numpy>=2.2" \
        "jieba>=0.42.1" \
        "pypinyin>=0.54.0"

COPY scripts/python_compat_sidecar.py /opt/pycompat/python_compat_sidecar.py

# 与 MaiBot 仓库布局对齐：源码挂载在 /MaiMBot/src，字频缓存写在 /MaiMBot/depends-data
WORKDIR /MaiMBot
EXPOSE 8767
ENTRYPOINT ["python", "/opt/pycompat/python_compat_sidecar.py"]
